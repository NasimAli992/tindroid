<?xml version="1.0" encoding="utf-8"?>
<!-- 
    Modern Glassmorphic Bottom Navigation Bar
    Inspired by Telegram, Discord, WhatsApp, and Instagram
    Features: Smooth animations, premium UI/UX, responsive design
    Android compatibility: API 21+
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:background="@drawable/bottom_nav_background"
    android:elevation="8dp">

    <!-- Main Navigation Container with Glassmorphic Effect -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <!-- Notifications Tab -->
        <FrameLayout
            android:id="@+id/nav_notifications"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/nav_item_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="4dp">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp">

                    <!-- Bell Icon -->
                    <ImageView
                        android:id="@+id/icon_notifications"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_notifications"
                        android:contentDescription="@string/notifications"
                        android:tint="@color/nav_icon_inactive"
                        android:scaleType="centerInside" />

                    <!-- Unread Badge -->
                    <View
                        android:id="@+id/badge_notifications"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="top|end"
                        android:layout_marginEnd="-4dp"
                        android:layout_marginTop="-4dp"
                        android:background="@drawable/notification_badge"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/notifications"
                    android:textSize="10sp"
                    android:textColor="@color/nav_label_inactive"
                    android:marginTop="4dp"
                    android:textStyle="normal" />
            </LinearLayout>
        </FrameLayout>

        <!-- Channels Tab -->
        <FrameLayout
            android:id="@+id/nav_channels"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/nav_item_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="4dp">

                <!-- Hashtag Icon -->
                <ImageView
                    android:id="@+id/icon_channels"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_channels"
                    android:contentDescription="@string/channels"
                    android:tint="@color/nav_icon_inactive"
                    android:scaleType="centerInside" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/channels"
                    android:textSize="10sp"
                    android:textColor="@color/nav_label_inactive"
                    android:marginTop="4dp"
                    android:textStyle="normal" />
            </LinearLayout>
        </FrameLayout>

        <!-- Messages Tab (Primary Active Tab) -->
        <FrameLayout
            android:id="@+id/nav_messages"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:background="@drawable/nav_item_background_active">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="4dp">

                <!-- Message Bubble Icon with Glow Effect -->
                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp">

                    <!-- Glow effect background -->
                    <View
                        android:id="@+id/glow_background"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@drawable/glow_effect"
                        android:alpha="0.3" />

                    <!-- Message bubble icon -->
                    <ImageView
                        android:id="@+id/icon_messages"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_messages"
                        android:contentDescription="@string/messages"
                        android:tint="@color/nav_icon_active"
                        android:scaleType="centerInside" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/messages"
                    android:textSize="10sp"
                    android:textColor="@color/nav_label_active"
                    android:marginTop="4dp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Voice Club Tab -->
        <FrameLayout
            android:id="@+id/nav_voice_club"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/nav_item_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="4dp">

                <!-- Waveform Icon -->
                <ImageView
                    android:id="@+id/icon_voice_club"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_voice_club"
                    android:contentDescription="@string/voice_club"
                    android:tint="@color/nav_icon_inactive"
                    android:scaleType="centerInside" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_club"
                    android:textSize="10sp"
                    android:textColor="@color/nav_label_inactive"
                    android:marginTop="4dp"
                    android:textStyle="normal" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>